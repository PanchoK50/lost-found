# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Voice input (speech to text) for the website. Put real keys in website/.env.local.
ELEVENLABS_API_KEY=

# Web app -> building agent (optional; this is the default).
LOSTFOUND_API_URL=http://127.0.0.1:8000

# Supabase (project lost-found). The publishable key may be public; the secret key and demo password stay server-side.
# Python backend reads SUPABASE_URL / SUPABASE_SECRET_KEY; the web app reads the NEXT_PUBLIC_* ones from website/.env.local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shared password of the demo accounts (scripts/create_demo_users.py); never sent to the browser.
DEMO_PASSWORD=
